# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=2500

# Database Configuration
DB_URL=postgresql://username:password@host:port/database_name
DB_LOCAL_URL=postgresql://username:password@localhost:5432/local_database_name

# JWT Configuration
JWT_SECRET=your-very-secure-jwt-secret-key-at-least-256-bits

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Configuration (Brevo/SendinBlue)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100
SMTP_RETRY_ATTEMPTS=1
SMTP_FALLBACK_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_CONNECTION_TIMEOUT_MS=20000
SMTP_GREETING_TIMEOUT_MS=20000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TLS_MIN_VERSION=TLSv1.2
EMAIL_FROM=noreply@yourdomain.com

# Payment Configuration (Paystack)
PAYSTACK_SECRET_KEY=your-paystack-secret-key
